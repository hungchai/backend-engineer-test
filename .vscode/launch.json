{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Launch UTXO Indexer",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/src/index.ts",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["--inspect"],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "env": {
                "DATABASE_URL": "postgresql://postgres:password@localhost:5432/utxo_indexer",
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "🐛 Debug UTXO Indexer",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/src/index.ts",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["--inspect-brk"],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "env": {
                "DATABASE_URL": "postgresql://postgres:password@localhost:5432/utxo_indexer",
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "stopOnEntry": false
        },
        {
            "name": "🧪 Run Tests",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/spec",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["test"],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "env": {
                "TEST_DATABASE_URL": "postgresql://postgres:password@localhost:5432/utxo_indexer_test",
                "NODE_ENV": "test"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "🔍 Debug Tests",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/spec",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["test", "--inspect-brk"],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "env": {
                "TEST_DATABASE_URL": "postgresql://postgres:password@localhost:5432/utxo_indexer_test",
                "NODE_ENV": "test"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "name": "🐳 Debug with Docker DB",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/src/index.ts",
            "runtimeExecutable": "bun",
            "runtimeArgs": ["--inspect-brk"],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**"
            ],
            "env": {
                "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/utxo_indexer",
                "NODE_ENV": "development"
            },
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "preLaunchTask": "docker-compose-up"
        }
    ]
}