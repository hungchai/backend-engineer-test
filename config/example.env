# Example Environment Configuration
# Copy this to .env and modify as needed

# Application Environment (development, production, test)
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Database Configuration
# Option 1: Full connection string (recommended for production)
DATABASE_URL=postgresql://username:password@localhost:5432/utxo_indexer

# Option 2: Individual components (will be merged into connection string)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=utxo_indexer
# DB_USER=postgres
# DB_PASSWORD=password

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Cache Configuration
CACHE_ENABLED=false
CACHE_TTL=300
CACHE_MAX_MEMORY=100
REDIS_URL=redis://localhost:6379

# Indexer Settings
MAX_ROLLBACK_DEPTH=2000
BATCH_SIZE=1000
ENABLE_METRICS=true

# Logging Configuration
LOG_LEVEL=info
LOG_PRETTY=true 