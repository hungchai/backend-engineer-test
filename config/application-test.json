{
  "server": {
    "port": 3000
  },
  "database": {
    "database": "utxo_indexer_test",
    "poolSize": 2,
    "maxConnections": 5
  },
  "cache": {
    "enabled": false
  },
  "indexer": {
    "maxRollbackDepth": 100,
    "batchSize": 10,
    "enableMetrics": false
  },
  "logging": {
    "level": "error",
    "prettyPrint": false
  }
}