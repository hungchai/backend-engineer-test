# UTXO Blockchain Indexer API Tests
# Use this file with the REST Client VS Code extension

@baseUrl = http://localhost:3000
@contentType = application/json

### 1. Get API Information
GET {{baseUrl}}/

### 2. Health Check
GET {{baseUrl}}/health

### 3. Performance Metrics
GET {{baseUrl}}/metrics

### 4. Process Genesis Block (Height 1)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "5feceb66ffc86f38d952786c6d696c79c2dbc239dd4e91b46729d73a27fb57e9",
  "height": 1,
  "transactions": [{
    "id": "tx1",
    "inputs": [],
    "outputs": [{
      "address": "addr1",
      "value": 10
    }]
  }]
}

### 5. Check Balance for addr1 (should be 10)
GET {{baseUrl}}/balance/addr1

### 6. Process Block 2 - Transfer Transaction
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "d4735e3a265e16eee03f59718b9b5d03019c07d8b6c51f90da3a666eec13ab35",
  "height": 2,
  "transactions": [{
    "id": "tx2",
    "inputs": [{
      "txId": "tx1",
      "index": 0
    }],
    "outputs": [{
      "address": "addr2",
      "value": 4
    }, {
      "address": "addr3",
      "value": 6
    }]
  }]
}

### 7. Check Balances After Transfer
GET {{baseUrl}}/balance/addr1

GET {{baseUrl}}/balance/addr2

GET {{baseUrl}}/balance/addr3

### 8. Process Block 3 - Complex Transaction
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "4e07408562bedb8b60ce05c1decfe3ad16b72230967de01f640b7e4729b49fce",
  "height": 3,
  "transactions": [{
    "id": "tx3",
    "inputs": [{
      "txId": "tx2",
      "index": 1
    }],
    "outputs": [{
      "address": "addr4",
      "value": 2
    }, {
      "address": "addr5",
      "value": 2
    }, {
      "address": "addr6",
      "value": 2
    }]
  }]
}

### 9. Check Final Balances
GET {{baseUrl}}/balance/addr1

GET {{baseUrl}}/balance/addr2

GET {{baseUrl}}/balance/addr3

GET {{baseUrl}}/balance/addr4

GET {{baseUrl}}/balance/addr5

GET {{baseUrl}}/balance/addr6

### 10. Rollback to Height 2
POST {{baseUrl}}/rollback?height=2

### 11. Check Balances After Rollback
GET {{baseUrl}}/balance/addr1

GET {{baseUrl}}/balance/addr2

GET {{baseUrl}}/balance/addr3

GET {{baseUrl}}/balance/addr4

GET {{baseUrl}}/balance/addr5

GET {{baseUrl}}/balance/addr6

### Error Test Cases

### 12. Test Invalid Height (should fail)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "invalid-hash",
  "height": 10,
  "transactions": [{
    "id": "tx-invalid",
    "inputs": [],
    "outputs": [{
      "address": "addr-test",
      "value": 100
    }]
  }]
}

### 13. Test Invalid Hash (should fail)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "wrong-hash-value",
  "height": 3,
  "transactions": [{
    "id": "tx-hash-test",
    "inputs": [],
    "outputs": [{
      "address": "addr-test",
      "value": 100
    }]
  }]
}

### 14. Test Missing Body (should fail)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

### 15. Test Invalid Address (should fail)
GET {{baseUrl}}/balance/

### 16. Test Invalid Rollback Height (should fail)
POST {{baseUrl}}/rollback?height=-1

### 17. Test Rollback Without Height (should fail)
POST {{baseUrl}}/rollback

### 18. Check Non-existent Address (should return 0)
GET {{baseUrl}}/balance/non-existent-address

### 19. Test 404 Endpoint (should fail)
GET {{baseUrl}}/non-existent-endpoint 