# UTXO Blockchain Indexer API Tests
# Use this file with the REST Client VS Code extension

@baseUrl = http://localhost:3000
@contentType = application/json

### 0. Clear Database (Development Only)
# This endpoint clears all blocks, transactions, UTXOs, and balances
# Only available in development mode
DELETE {{baseUrl}}/clear

### 1. Get API Information
GET {{baseUrl}}/

### 2. Health Check
GET {{baseUrl}}/health

### 3. Performance Metrics
GET {{baseUrl}}/metrics

### 4. Process Genesis Block (Height 1)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "d1582b9e2cac15e170c39ef2e85855ffd7e6a820550a8ca16a2f016d366503dc",
  "height": 1,
  "transactions": [{
    "id": "tx1",
    "inputs": [],
    "outputs": [{
      "address": "addr1",
      "value": 10
    }]
  }]
}

### 5. Check Balance for addr1 (should be 10)
GET {{baseUrl}}/balance/addr1

### 6. Process Block 2 - Transfer Transaction
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "c4701d0bfd7179e1db6e33e947e6c718bbc4a1ae927300cd1e3bda91a930cba5",
  "height": 2,
  "transactions": [{
    "id": "tx2",
    "inputs": [{
      "txId": "tx1",
      "index": 0
    }],
    "outputs": [{
      "address": "addr2",
      "value": 4
    }, {
      "address": "addr3",
      "value": 6
    }]
  }]
}

### 7. Check Balances After Transfer
GET {{baseUrl}}/balance/addr1

GET {{baseUrl}}/balance/addr2

GET {{baseUrl}}/balance/addr3

### 8. Process Block 3 - Complex Transaction
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "4e5f22a2abacfaf2dcaaeb1652aec4eb65028d0f831fa435e6b1ee931c6799ec",
  "height": 3,
  "transactions": [{
    "id": "tx3",
    "inputs": [{
      "txId": "tx2",
      "index": 1
    }],
    "outputs": [{
      "address": "addr4",
      "value": 2
    }, {
      "address": "addr5",
      "value": 2
    }, {
      "address": "addr6",
      "value": 2
    }]
  }]
}

### 9. Check Final Balances
GET {{baseUrl}}/balance/addr1

GET {{baseUrl}}/balance/addr2

GET {{baseUrl}}/balance/addr3

GET {{baseUrl}}/balance/addr4

GET {{baseUrl}}/balance/addr5

GET {{baseUrl}}/balance/addr6

### 10. Rollback to Height 2
POST {{baseUrl}}/rollback?height=2

### 11. Check Balances After Rollback
GET {{baseUrl}}/balance/addr1

GET {{baseUrl}}/balance/addr2

GET {{baseUrl}}/balance/addr3

GET {{baseUrl}}/balance/addr4

GET {{baseUrl}}/balance/addr5

GET {{baseUrl}}/balance/addr6

### Error Test Cases

### 12. Test Invalid Height (should fail)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "invalid-hash",
  "height": 10,
  "transactions": [{
    "id": "tx-invalid",
    "inputs": [],
    "outputs": [{
      "address": "addr-test",
      "value": 100
    }]
  }]
}

### 13. Test Invalid Hash (should fail)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

{
  "id": "wrong-hash-value",
  "height": 3,
  "transactions": [{
    "id": "tx-hash-test",
    "inputs": [],
    "outputs": [{
      "address": "addr-test",
      "value": 100
    }]
  }]
}

### 14. Test Missing Body (should fail)
POST {{baseUrl}}/blocks
Content-Type: {{contentType}}

### 15. Test Invalid Address (should fail)
GET {{baseUrl}}/balance/

### 16. Test Invalid Rollback Height (should fail)
POST {{baseUrl}}/rollback?height=-1

### 17. Test Rollback Without Height (should fail)
POST {{baseUrl}}/rollback

### 18. Check Non-existent Address (should return 0)
GET {{baseUrl}}/balance/non-existent-address

### 19. Test 404 Endpoint (should fail)
GET {{baseUrl}}/non-existent-endpoint 