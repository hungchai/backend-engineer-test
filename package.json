{
  "name": "backend-engineer-test",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "run-docker": "docker-compose up -d --build",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir=dist",
    "clean": "rm -rf dist",
    "lint": "echo 'Linting with TypeScript compiler'",
    "db:setup": "echo 'Run docker-compose up to setup PostgreSQL'",
    "health-check": "curl -f http://localhost:3000/health || exit 1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.15.4",
    "testcontainers": "^11.3.0",
    "@types/better-sqlite3": "^7.6.9"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@testcontainers/postgresql": "^11.3.0",
    "better-sqlite3": "^12.2.0",
    "fastify": "^4.28.1",
    "pg": "^8.16.3",
    "pino-pretty": "^13.0.0"
  }
}